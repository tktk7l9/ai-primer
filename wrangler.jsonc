/**
 * ai-primer — Cloudflare Workers config
 * https://developers.cloudflare.com/workers/framework-guides/web-apps/nextjs/
 *
 * Builds Next.js with @opennextjs/cloudflare and runs it on Workers.
 * Migrated because the Vercel Hobby account has been suspended since 2026-08-11.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-primer",
  // worker.ts wraps .open-next/worker.js to give HTML responses a per-request script nonce
  // (src/lib/csp-nonce.ts). Pointing this back at .open-next/worker.js silently restores
  // script-src 'unsafe-inline' (src/lib/worker-entry.test.ts blocks it).
  "main": "worker.ts",
  // This date is validated in UTC. Putting "today" in JST can hit an "in the future" error
  // because UTC is still on the previous day (actually happened in the 2026-09-13 deploy).
  "compatibility_date": "2026-09-12",
  // Required to run Next.js. The date must be 2024-09-23 or later.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
