# Header rules for Cloudflare Workers static assets.
# https://developers.cloudflare.com/workers/static-assets/headers/
# https://opennext.js.org/cloudflare/caching#static-assets-caching
#
# Workers Assets serves /_next/static/* before the Worker runs, so the
# headers() in next.config.ts never reach these files. Next.js emits them with
# content hashes, so they can be cached forever; nosniff is restated because the
# Worker's header set does not apply here either.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# app/favicon.ico is copied into .open-next/assets as well, so Workers Assets
# serves it the same way (measured on 2026-10-26: no nosniff on the production
# /favicon.ico while /icon.svg, rendered by the Worker, had it). It is not
# content-hashed, so it keeps the Workers Assets default Cache-Control.
/favicon.ico
  X-Content-Type-Options: nosniff
